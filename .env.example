# Firefly III API Configuration
FIREFLY_III_URL=https://your-firefly-iii-instance.com
FIREFLY_III_TOKEN=your-personal-access-token

# LLM Configuration (any OpenAI-compatible API, defaults to Google Gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.5-flash

# JPEG quality (1-100) of the receipt image sent to the LLM
IMAGE_QUALITY=85

# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
# Claude:  LLM_BASE_URL=https://api.anthropic.com/v1/        LLM_MODEL=claude-sonnet-5-5
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=qwen2.5vl  (LLM_API_KEY=ollama)

# Pre-tick "Attach receipt image to transaction" on the review page (true/false)
ATTACH_RECEIPT_DEFAULT=true

# Matching receipts against transactions that already exist (e.g. from a bank import)
# Pre-tick "Match with existing transactions" on the upload page (true/false)
MATCH_EXISTING_DEFAULT=false
# Look this many days before/after the receipt date
MATCH_DATE_WINDOW_DAYS=3
# Allowed amount difference when receipt and transaction use the same currency
MATCH_AMOUNT_TOLERANCE=0.00
# Allowed difference (%) when the receipt is in another currency and was converted
MATCH_FX_TOLERANCE_PERCENT=5
# Exchange rates source ({base} = receipt currency); leave empty to disable conversion
FX_RATES_URL=https://open.er-api.com/v6/latest/{base}
